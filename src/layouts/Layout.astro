---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "A modern website powered by Astro and Decap CMS" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} | Demo App</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href={base} class="nav-logo">
          <span class="logo-mark">▲</span>
          <span class="logo-text">Demo App</span>
        </a>
        <ul class="nav-links">
          <li><a href={base}>Home</a></li>
          <li><a href={`${base}blog`}>Blog</a></li>
          <li><a href={`${base}admin/`} class="nav-cta">Admin</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">Demo App</p>
        <p class="footer-copy">Built with Astro + Decap CMS · <a href="https://github.com/poleak-theng065/demo-app" target="_blank">GitHub</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0a0a0f;
    --bg-card: #13131a;
    --bg-card-hover: #1a1a24;
    --border: rgba(255,255,255,0.08);
    --border-hover: rgba(255,255,255,0.18);
    --text: #e8e8f0;
    --text-muted: #888899;
    --text-dim: #55556a;
    --accent: #7c6af7;
    --accent-glow: rgba(124, 106, 247, 0.3);
    --accent-2: #f768a0;
    --gold: #f0c060;
    --font-display: 'Syne', sans-serif;
    --font-body: 'DM Sans', sans-serif;
    --radius: 12px;
    --radius-lg: 20px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    line-height: 1.7;
    background-image:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(124, 106, 247, 0.12), transparent),
      radial-gradient(ellipse 60% 40% at 80% 80%, rgba(247, 104, 160, 0.06), transparent);
  }

  a { color: inherit; text-decoration: none; }

  /* NAV */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0 2rem;
    background: rgba(10, 10, 15, 0.8);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .logo-mark {
    color: var(--accent);
    font-size: 0.9rem;
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a {
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color 0.2s;
    font-weight: 500;
  }

  .nav-links a:hover { color: var(--text); }

  .nav-cta {
    background: var(--accent) !important;
    color: #fff !important;
    padding: 0.4rem 1rem !important;
    border-radius: 6px !important;
    font-weight: 600 !important;
    transition: opacity 0.2s, transform 0.2s !important;
  }

  .nav-cta:hover { opacity: 0.85 !important; transform: translateY(-1px) !important; }

  /* FOOTER */
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 2rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text-muted);
  }

  .footer-copy {
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .footer-copy a {
    color: var(--accent);
    transition: opacity 0.2s;
  }

  .footer-copy a:hover { opacity: 0.75; }

  /* PROSE */
  .prose {
    max-width: 720px;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text);
  }

  .prose h1, .prose h2, .prose h3 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #fff;
  }

  .prose p { margin-bottom: 1.25rem; }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
  .prose li { margin-bottom: 0.4rem; }

  .prose code {
    background: rgba(124, 106, 247, 0.15);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
    color: var(--accent);
  }

  .prose pre {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .prose pre code {
    background: none;
    padding: 0;
    color: var(--text);
  }

  @media (max-width: 640px) {
    .nav-links { gap: 1rem; }
    .nav-links li:not(:last-child) { display: none; }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
const base = import.meta.env.BASE_URL;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="post-page">
    <header class="post-header">
      <a href={`${base}blog`} class="back-link">← Back to blog</a>

      <div class="post-tags">
        {post.data.tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>

      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>

      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <span class="updated">
            · Updated {formatDate(post.data.updatedDate)}
          </span>
        )}
      </div>
    </header>

    {post.data.heroImage && (
      <div class="hero-image">
        <img src={post.data.heroImage} alt={post.data.title} />
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <a href={`${base}blog`} class="btn-back">← All Posts</a>
      <a href={`${base}admin/`} class="btn-edit">Edit in CMS ✏️</a>
    </footer>
  </article>
</Layout>

<style>
  .post-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: color 0.2s;
    font-weight: 500;
  }

  .back-link:hover { color: var(--text); }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .tag {
    background: rgba(124,106,247,0.12);
    border: 1px solid rgba(124,106,247,0.2);
    color: var(--accent);
    padding: 0.2rem 0.7rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .post-desc {
    font-size: 1.2rem;
    color: var(--text-muted);
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .post-meta {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .hero-image {
    margin-bottom: 3rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .hero-image img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    display: block;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .btn-back, .btn-edit {
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.2s;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-muted);
  }

  .btn-back:hover, .btn-edit:hover {
    border-color: var(--border-hover);
    color: var(--text);
  }

  .btn-edit {
    background: rgba(124,106,247,0.1);
    border-color: rgba(124,106,247,0.25);
    color: var(--accent);
  }
</style>
